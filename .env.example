# InfraScan 3D reads the provider key from the server environment only.
# Copy this file to .env and fill it in, or export MODEL_API_KEY before starting the server.
# Never commit the real key, and never put it in the frontend, a bundle or a browser tab.

# Meta Model API key. Left blank, the app stays in mock mode and labels every
# finding "simulated sam-3.1 / simulated rule engine".
MODEL_API_KEY=

# Optional overrides - all have defaults in infrascan/config.py
# INFRASCAN_MODE=mock                # force the simulator even when a key is present
# INFRASCAN_BASE_URL=https://api.meta.ai/v1
# INFRASCAN_SAM_MODEL=sam-3.1
# INFRASCAN_SPARK_MODEL=muse-spark-1.3
# INFRASCAN_MAX_UPLOAD_MB=20
# INFRASCAN_MAX_FRAMES=16            # video is billed per frame, so frames are capped
# INFRASCAN_MAX_CONCURRENCY=4        # simultaneous jobs in the queue
# INFRASCAN_TIMEOUT=180
# INFRASCAN_RETENTION_DAYS=14        # uploads/prepared media older than this are purged at boot
# INFRASCAN_DATA_DIR=./data          # sqlite file, uploads, prepared frames, outputs
# INFRASCAN_KNOWLEDGE_DIR=./knowledge
